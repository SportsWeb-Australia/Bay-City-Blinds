---
import { site } from '../data/site';
import { products, locations } from '../data/content';
---
<footer>
  <div class="wrap">
    <div class="fgrid">
      <div>
        <a href="/" class="brand" style="display:flex;align-items:center;gap:.6rem;font-family:'Bricolage Grotesque';font-weight:800;font-size:1.25rem">
          <span class="logo-mark" aria-hidden="true">
            <img src="/bay-city-blinds-badge.webp" width="76" height="76" alt="" />
          </span>
          <span>Bay City Blinds<br><small style="font-family:Inter;font-weight:600;font-size:.62rem;letter-spacing:.2em">GEELONG · MOBILE SHOWROOM</small></span>
        </a>
        <p style="font-size:.9rem;max-width:22rem">Local, family-owned blinds, shutters and curtains, measured and installed in your home since {site.founded}.</p>
        <p style="margin-top:.9rem;font-size:.9rem"><a href={site.phoneHref}>📞 Call {site.phone}</a><a href={site.smsHref}>💬 Text {site.phone}</a><a href={`mailto:${site.email}`}>✉️ {site.email}</a></p>
        <p class="f-socials" style="margin-top:.9rem;display:flex;gap:.7rem">
          <a href={site.facebook} aria-label="Bay City Blinds on Facebook" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.23.2 2.23.2v2.45h-1.26c-1.24 0-1.63.77-1.63 1.56v1.89h2.78l-.44 2.91h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94z"/></svg></a>
          <a href={site.instagram} aria-label="Bay City Blinds on Instagram" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg></a>
          <a href={site.youtube || '#'} aria-label="Bay City Blinds on YouTube" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M23.5 6.2a3 3 0 00-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 00.5 6.2 31 31 0 000 12a31 31 0 00.5 5.8 3 3 0 002.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 002.1-2.1A31 31 0 0024 12a31 31 0 00-.5-5.8zM9.6 15.6V8.4L15.8 12l-6.2 3.6z"/></svg></a>
        </p>
      </div>
      <div><h4>Products</h4>{products.map((p) => <a href={`/blinds/${p.slug}`}>{p.name}</a>)}<a href="/security">Security</a></div>
      <div><h4>Service Areas</h4>{locations.slice(0, 6).map((l) => <a href={`/${l.slug}`}>{l.name}</a>)}</div>
      <div><h4>Company</h4>
        <a href="/#process">How it works</a><a href="/#gallery">Our work</a><a href="/reviews">Reviews</a><a href="/#faq">FAQ</a>
        <a href="/free-measure-quote">Free measure &amp; quote</a><a href="/about">About Jackson</a>
      </div>
    </div>
    <div class="fbar">
      <span>© {new Date().getFullYear()} {site.name} · ABN {site.abn} · Geelong, VIC</span>
      <span>Free in-home measure &amp; quote across Geelong &amp; the Bellarine</span>
    </div>
  </div>
</footer>
<div class="mobile-bar">
  <a class="btn btn-ghost" href={site.phoneHref}>📞 Call</a>
  <a class="btn btn-ghost" href={site.smsHref}>💬 Text</a>
  <a class="btn btn-primary" href="/free-measure-quote">Quote →</a>
</div>
