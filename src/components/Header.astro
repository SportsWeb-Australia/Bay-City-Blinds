---
import { site } from '../data/site';

// Nav structure. `href: null` items don't have a page yet — rendered as
// non-clickable placeholders until Carson confirms which ones to build.
const nav = [
  {
    label: 'Curtains', href: '/blinds/curtains',
    children: [
      { label: 'Sheers', href: null },
      { label: 'Blockouts', href: null },
      { label: 'Light filter', href: null },
      { label: 'Pelmet boxes', href: null },
    ],
  },
  {
    label: 'Indoor Blinds & Shutters', href: '/indoor',
    children: [
      { label: 'Roller blinds', href: '/blinds/roller-blinds' },
      { label: 'Honeycomb blinds', href: '/blinds/honeycomb-blinds' },
      { label: 'Venetian blinds', href: '/blinds/venetian-blinds' },
      { label: 'Plantation shutters', href: '/blinds/plantation-shutters' },
      { label: 'Blockouts', href: null },
      { label: 'Pelmet boxes', href: null },
    ],
  },
  {
    label: 'Outdoor', href: '/outdoor',
    children: [
      { label: 'Zip screens', href: '/blinds/outdoor-screens' },
      { label: 'Roller shutters', href: '/blinds/roller-shutters' },
      { label: 'Awnings', href: '/blinds/traditional-awnings' },
      { label: 'Folding arm awnings', href: '/blinds/folding-arm-awnings' },
    ],
  },
  {
    label: 'Security', href: null,
    children: [
      { label: 'Security doors', href: null },
      { label: 'Security shutters', href: null },
    ],
  },
  {
    label: 'Motorised', href: null,
    children: [
      { label: 'Solar', href: null },
      { label: 'Battery', href: null },
      { label: 'Hard wired', href: null },
      { label: 'Linx', href: null },
      { label: 'Somfy', href: null },
      { label: 'Automate', href: null },
      { label: 'Alpha', href: null },
    ],
  },
  { label: 'Service areas', href: '/#areas', children: null },
  { label: 'Reviews', href: '/reviews', children: null },
];
---
<div class="util">
  <div class="wrap">
    <span>★ Local &amp; family-owned in Geelong since {site.founded}</span>
    <span>
      <a href={site.phoneHref}>Call {site.phone}</a>
      <span class="dot">•</span>
      <a href={site.smsHref}>Text us</a>
      <span class="dot">•</span>
      <a href="/free-measure-quote" data-cta="utility-free-quote">Free measure &amp; quote →</a>
    </span>
  </div>
</div>
<header>
  <nav class="nav">
    <a class="brand" href="/">
      <span class="logo-mark" aria-hidden="true">
        <img src="/bay-city-blinds-badge.webp" width="76" height="76" alt="" />
      </span>
      <span class="brand-text">Bay City Blinds<small>Geelong · mobile showroom</small></span>
    </a>
    <div class="nav-links">
      {nav.map((item) => (
        item.children ? (
          <div class="nav-item">
            {item.href ? (
              <a href={item.href} class="nav-drop-label">{item.label}<i class="caret" aria-hidden="true"></i></a>
            ) : (
              <button type="button" class="nav-drop-label nav-drop-btn">{item.label}<i class="caret" aria-hidden="true"></i></button>
            )}
            <div class="nav-dropdown">
              {item.children.map((c) => (
                c.href ? <a href={c.href}>{c.label}</a> : <span class="soon" title="Coming soon">{c.label}</span>
              ))}
            </div>
          </div>
        ) : (
          <a href={item.href}>{item.label}</a>
        )
      ))}
    </div>
    <div class="nav-cta">
      <a class="nav-phone" href={site.phoneHref}>{site.phone}</a>
      <a class="btn btn-primary" href="/free-measure-quote" data-cta="nav-free-quote">Free quote</a>
      <button class="burger" id="navBurger" aria-label="Open menu" aria-expanded="false" aria-controls="navMobile">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>
  <div class="nav-mobile" id="navMobile">
    {nav.map((item) => (
      item.children ? (
        <div class="nav-mobile-item">
          <button type="button" class="nav-mobile-toggle">{item.label}<i class="caret" aria-hidden="true"></i></button>
          <div class="nav-mobile-sub">
            {item.href && <a href={item.href}>All {item.label.toLowerCase()}</a>}
            {item.children.map((c) => (
              c.href ? <a href={c.href}>{c.label}</a> : <span class="soon" title="Coming soon">{c.label}</span>
            ))}
          </div>
        </div>
      ) : (
        <a href={item.href}>{item.label}</a>
      )
    ))}
    <a href={site.phoneHref}>{site.phone}</a>
  </div>
</header>
<script>
  const burger = document.getElementById('navBurger');
  const navMobile = document.getElementById('navMobile');
  burger?.addEventListener('click', () => {
    const open = navMobile?.classList.toggle('open');
    burger.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  navMobile?.querySelectorAll(':scope > a').forEach((a) => a.addEventListener('click', () => {
    navMobile.classList.remove('open');
    burger?.setAttribute('aria-expanded', 'false');
  }));
  navMobile?.querySelectorAll('.nav-mobile-sub a').forEach((a) => a.addEventListener('click', () => {
    navMobile.classList.remove('open');
    burger?.setAttribute('aria-expanded', 'false');
  }));
  navMobile?.querySelectorAll('.nav-mobile-toggle').forEach((btn) => btn.addEventListener('click', () => {
    btn.parentElement?.classList.toggle('open');
  }));
</script>
