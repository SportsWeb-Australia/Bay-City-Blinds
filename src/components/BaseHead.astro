---
import { site } from '../data/site';
// GA4 Measurement ID — set PUBLIC_GA_ID as a Cloudflare Pages build env var (public, not a
// secret). Placeholder below until Carson creates the GA4 property.
const gaId = import.meta.env.PUBLIC_GA_ID || 'G-XXXXXXXXXX';
// Google Ads conversion tracking. Set PUBLIC_GOOGLE_ADS_ID (AW-XXXXXXXXX) and the two
// conversion labels as Cloudflare Pages build env vars. Until PUBLIC_GOOGLE_ADS_ID is
// set, every Ads call below is a no-op and only GA4 runs.
const adsId = import.meta.env.PUBLIC_GOOGLE_ADS_ID || '';
const adsLeadLabel = import.meta.env.PUBLIC_GOOGLE_ADS_LEAD_LABEL || '';
const adsCallLabel = import.meta.env.PUBLIC_GOOGLE_ADS_CALL_LABEL || '';
const analyticsId = gaId !== 'G-XXXXXXXXXX' ? gaId : '';
// gtag.js only needs loading once; either product can host the loader.
const loaderId = analyticsId || adsId;
export interface Props {
  title: string;
  description: string;
  path?: string;          // e.g. "/blinds-armstrong-creek"
  ogImage?: string;
  robots?: string;
  schemas?: object[];     // JSON-LD objects rendered into the page HEAD
}
const {
  title,
  description,
  path = '',
  ogImage = site.ogImage,
  robots = 'index,follow,max-image-preview:large',
  schemas = [],
} = Astro.props;
const canonical = new URL(path, site.url).href;
const ogUrl = new URL(ogImage, site.url).href;
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
<meta name="geo.region" content="AU-VIC" />
<meta name="geo.placename" content="Geelong" />
<meta name="google-site-verification" content="cEVaJAn6f04ynK7AYwocgfQ7fFmTknp5PnrWIelafAE" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:locale" content="en_AU" />
<meta property="og:site_name" content={site.name} />
<meta name="twitter:card" content="summary_large_image" />

<link rel="icon" type="image/png" href="/favicon-32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

<!-- Structured data: rendered at build time, so crawlers & AI get it with zero JS -->
{schemas.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}

{loaderId && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${loaderId}`}></script>
    <script define:vars={{ analyticsId, adsId, adsLeadLabel, adsCallLabel }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      if (analyticsId) gtag('config', analyticsId);
      if (adsId) gtag('config', adsId);
      window.gtag = gtag;
      window.GADS = { id: adsId, leadLabel: adsLeadLabel, callLabel: adsCallLabel };
      // Fires a Google Ads conversion. No-op unless both the account id and the
      // relevant conversion label are configured, so it is safe to call anywhere.
      window.gadsConversion = function (label, params) {
        if (!adsId || !label || typeof window.gtag !== 'function') return;
        window.gtag('event', 'conversion', Object.assign({ send_to: adsId + '/' + label }, params || {}));
      };
    </script>
  </>
)}
