---
const brands = [
  { name: 'Shaw Fabrics', url: 'https://shawblindfabrics.com/' },
  { name: 'Nettex', url: 'https://www.nettex.com.au/' },
  { name: 'Ozroll', url: 'https://www.ozroll.com.au/' },
  { name: 'Linx', url: 'https://linxautomation.com.au/' },
  { name: 'Somfy', url: 'https://www.somfy.com.au/' },
  { name: 'Acmeda', url: 'https://www.rolleaseacmeda.com/au' },
  { name: 'Norman Australia', url: 'https://normanaustralia.com.au/' },
];
---
<section class="block" style="padding:2.6rem 0">
  <div class="wrap">
    <div class="aussie-made-strip reveal">
      <img src="/aussie-made.webp" width="120" height="80" loading="lazy" alt="Australian Made certified" />
      <p>Bay City Blinds’ products are proudly <b>Australian made</b>, and every job is <b>locally manufactured, serviced and installed</b> right here in Geelong, not outsourced or shipped in from overseas.</p>
    </div>
    <p class="eyebrow reveal" style="text-align:center;margin-bottom:1.1rem">Trusted Australian brands</p>
    <div class="brands reveal">
      {brands.map((b) => (
        <a class="brand-chip" href={b.url} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l2.9 6.3 6.9.6-5.2 4.6 1.6 6.8L12 17.3 5.8 20.9l1.6-6.8L2.2 8.9l6.9-.6z"/></svg>
          <span>{b.name}</span>
        </a>
      ))}
    </div>
  </div>
  <!-- Logo image files not supplied yet — swap the brand-chip text mark for
       each supplier's real logo once Jackson confirms he can display them. -->
</section>
