---
import { locations } from '../data/content';
import ServiceAreaMap from './ServiceAreaMap.tsx';
---
<section class="block tint" id="areas">
  <div class="wrap">
    <div class="areas">
      <div class="reveal">
        <p class="eyebrow">Where we work</p>
        <h2 style="font-size:clamp(1.7rem,3vw,2.3rem);font-weight:800;margin:.4rem 0 .6rem">Proudly serving Geelong &amp; beyond</h2>
        <p style="color:var(--muted)">From the heart of Geelong to the Surf Coast, the Bellarine and out to Melbourne's west, if you're nearby, Jackson will come to you. Tap your area for a local free measure &amp; quote.</p>
        <div class="area-chips">
          {locations.map((l) => <a href={`/${l.slug}`}>{l.name}</a>)}
        </div>
        <a class="btn btn-primary btn-lg" href="/free-measure-quote#quote" style="margin-top:1.5rem">Check your suburb →</a>
      </div>
      <div class="map-live reveal">
        <ServiceAreaMap client:load />
      </div>
      </div>
      <p class="map-crawltext">
        Bay City Blinds services Geelong and surrounding suburbs, including Highton, Newtown, Belmont, Armstrong Creek,
        Mount Duneed, Geelong West, Manifold Heights and Lara. Our wider service area covers the Surf Coast (Torquay,
        Jan Juc, Anglesea) and Winchelsea, the full Bellarine Peninsula (Barwon Heads, Ocean Grove, Point Lonsdale,
        Queenscliff, St Leonards, Drysdale, Portarlington), and out to Melbourne's west including Werribee, Tarneit,
        Point Cook, Altona, Williamstown and Footscray.
      </p>
    </div>
  </div>
</section>
