---
export interface Props { label?: string }
const { label = 'Video coming soon' } = Astro.props;
---
<section class="block tint" style="padding-top:2rem;padding-bottom:2rem">
  <div class="wrap">
    <div class="video-placeholder reveal">
      <div class="video-play" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      </div>
      <p>{label}</p>
    </div>
  </div>
</section>
