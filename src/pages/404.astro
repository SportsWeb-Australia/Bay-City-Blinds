---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { localBusiness } from '../data/schema';

const title = 'Page not found | Bay City Blinds';
const description = 'That page couldn’t be found. Explore our indoor and outdoor blinds range or get a free measure & quote.';
const schemas = [localBusiness()];
---
<Layout title={title} description={description} path="/404" schemas={schemas} robots="noindex,follow">
  <section class="block" style="text-align:center;padding-top:4rem;padding-bottom:4rem">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>We couldn't find that page</h1>
      <p class="sub" style="max-width:34rem;margin:.6rem auto 1.8rem">
        The page you're after has moved or doesn't exist. Try one of these instead, or get in touch directly.
      </p>
      <div class="trust-chips" style="justify-content:center;margin-bottom:2rem">
        <a class="chip" href="/indoor">Indoor blinds &amp; shutters</a>
        <a class="chip" href="/outdoor">Zipscreen</a>
        <a class="chip" href="/blinds">Full range</a>
        <a class="chip" href="/free-measure-quote">Free measure &amp; quote</a>
      </div>
      <p class="sub">
        Or call <a href={site.phoneHref}>{site.phone}</a> / email <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </section>
</Layout>
