---
import Layout from '../layouts/Layout.astro';
import Products from '../components/Products.astro';
import WhyUs from '../components/WhyUs.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import FinalCta from '../components/FinalCta.astro';
import { localBusiness, serviceSchema, breadcrumb } from '../data/schema';

const title = 'Indoor Blinds, Shutters & Curtains Geelong | Bay City Blinds';
const description = 'Roller blinds, roman blinds, Venetians, plantation shutters and made-to-measure curtains for every room. Free in-home measure & quote across Geelong & the Bellarine.';
const schemas = [
  localBusiness(),
  serviceSchema(),
  breadcrumb([{ name: 'Home', url: '/' }, { name: 'Indoor', url: '/indoor' }]),
];
---
<Layout title={title} description={description} path="/indoor" schemas={schemas}>
  <section class="block" style="padding-bottom:1rem">
    <div class="wrap">
      <div class="sec-head reveal" style="margin-bottom:1rem">
        <p class="eyebrow">Indoor window furnishings</p>
        <h2>Blinds, shutters &amp; curtains for every room</h2>
        <p>All made to measure, all installed in your home by a local. Tap any product for a free quote.</p>
      </div>
    </div>
  </section>
  <Products category="indoor" hideHeading />
  <WhyUs />
  <ServiceAreas />
  <FinalCta />
</Layout>
