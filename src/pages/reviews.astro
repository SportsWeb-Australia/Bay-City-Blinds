---
import Layout from '../layouts/Layout.astro';
import Reviews from '../components/Reviews.astro';
import GoogleReviewsWidget from '../components/GoogleReviewsWidget.astro';
import FinalCta from '../components/FinalCta.astro';
import { localBusiness, breadcrumb } from '../data/schema';
const title = 'Reviews | Bay City Blinds | Blinds Geelong';
const description = 'See why Geelong & Bellarine homeowners rate Bay City Blinds 5 stars. Real reviews of our mobile measure & quote, quality blinds and tidy installs.';
const schemas = [localBusiness(), breadcrumb([{ name:'Home', url:'/' }, { name:'Reviews', url:'/reviews' }])];
---
<Layout title={title} description={description} path="/reviews" schemas={schemas}>
  <section class="block" style="padding-bottom:0">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">Real local reviews</p>
        <h1>Bay City Blinds reviews, Geelong</h1>
        <p>See why Geelong &amp; Bellarine homeowners rate Bay City Blinds 5 stars for mobile measure &amp; quote, quality blinds and tidy installs.</p>
      </div>
    </div>
  </section>
  <Reviews />
  <GoogleReviewsWidget />
  <FinalCta />
</Layout>
