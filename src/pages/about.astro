---
import Layout from '../layouts/Layout.astro';
import WhyUs from '../components/WhyUs.astro';
import Showroom from '../components/Showroom.astro';
import FinalCta from '../components/FinalCta.astro';
import { site } from '../data/site';
import { localBusiness, breadcrumb } from '../data/schema';
const title = 'About Bay City Blinds | Local Blinds, Geelong';
const description = 'Bay City Blinds is a local, family-owned mobile blinds business in Geelong, run by Jackson since 2020. Meet the friendly local who brings the showroom to you.';
const schemas = [localBusiness(), breadcrumb([{ name:'Home', url:'/' }, { name:'About', url:'/about' }])];
---
<Layout title={title} description={description} path="/about" schemas={schemas}>
  <section class="hero">
    <div class="wrap">
      <div class="hero-copy reveal">
        <p class="eyebrow">Meet your local Bay City Blinds isn’t a franchise — Jackson and his installers are the faces of the business, all police and security checked, with years of 5-star reviews behind the work. As a Geelong local with a young family, Jackson’s focus is simple: the best value workmanship and materials for the people of greater Geelong.</p>
        <h1>Hi, I'm <span class="hl">Jackson</span> — your Geelong blinds guy.</h1>
        <p class="sub">I started Bay City Blinds in {site.founded} with a simple idea: make buying blinds easy by bringing the showroom to you. No pushy sales, no showroom trips — just honest advice, quality products and a tidy install, right across Geelong and beyond.</p>
        <a class="btn btn-primary btn-lg" href="/free-measure-quote">Book a free quote with me →</a>
      </div>
      <div>
        <div class="hero-photo-card reveal">
          <img src="/jackson-van-square.webp" width="800" height="800" alt="Jackson, owner of Bay City Blinds, with his mobile showroom van in Geelong" />
          <div class="name-tag">Jackson <span>· owner, Bay City Blinds</span></div>
        </div>
      </div>
    </div>
  </section>
  <WhyUs />
  <Showroom />

  <section class="block tint" id="team">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">Who you'll meet</p>
        <h2>Meet the team</h2>
        <p>A small, trusted crew — no call centre, no rotating cast of subcontractors.</p>
      </div>
      <div class="team-grid">
        <div class="team-card reveal">
          <div class="team-photo"><img src="/jackson-install-square.webp" width="112" height="112" alt="Jackson, owner of Bay City Blinds, Geelong" /></div>
          <h3>Jackson</h3>
          <p class="role">Owner &amp; measure/quote</p>
          <p>Runs Bay City Blinds start to finish — visits your home, measures up, and sees every job through personally.</p>
        </div>
        <div class="team-card reveal">
          <div class="team-photo placeholder"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg></div>
          <h3>Tim</h3>
          <p class="role">Trusted installer</p>
          <p>Part of the Bay City Blinds install team — police and security checked, careful and tidy on every job.</p>
        </div>
      </div>
    </div>
  </section>

  <FinalCta />
</Layout>
