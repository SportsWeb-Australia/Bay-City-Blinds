---
import Layout from '../../layouts/Layout.astro';
import WhyUs from '../../components/WhyUs.astro';
import Reviews from '../../components/Reviews.astro';
import ServiceAreas from '../../components/ServiceAreas.astro';
import FinalCta from '../../components/FinalCta.astro';
import LeadForm from '../../components/LeadForm.tsx';
import { securityStyles, securityScreenOptions } from '../../data/content';
import { localBusiness, serviceSchema, breadcrumb } from '../../data/schema';

export function getStaticPaths() {
  return securityStyles.map((s) => ({ params: { style: s.slug }, props: { s } }));
}
const { s } = Astro.props;

const title = `${s.name} Geelong | Free Measure & Quote | Bay City Blinds`;
const description = `${s.long.slice(0, 140)} Free in-home measure & quote across Geelong & the Bellarine.`;
const schemas = [
  localBusiness(),
  serviceSchema(),
  breadcrumb([
    { name: 'Home', url: '/' },
    { name: 'Security', url: '/security' },
    { name: s.name, url: `/security/${s.slug}` },
  ]),
];
---
<Layout title={title} description={description} path={`/security/${s.slug}`} schemas={schemas}>
  <section class="hero">
    <div class="wrap">
      <div class="hero-copy reveal">
        <p class="eyebrow">Made to measure · Geelong &amp; the Bellarine</p>
        <h1>{s.name} in <span class="hl">Geelong</span></h1>
        <p class="sub">{s.long}</p>
        <a class="btn btn-primary btn-lg" href="#quote" style="margin-top:.6rem">Get my free quote →</a>
      </div>
      <div>
        <div class="hero-orb-wrap hero-orb-sub reveal">
          <div class="orb-ring" aria-hidden="true"></div>
          <img class="hero-orb" src={s.heroImage || '/jackson-orb.webp'} width="1000" height="1000" alt={`${s.name} measured and installed by Bay City Blinds, Geelong`} />
          {!s.heroImage && <div class="name-tag">Jackson <span>· your local blinds guy</span></div>}
        </div>
      </div>
    </div>
    <div class="wrap" id="quote" style="padding-bottom:3rem;margin-top:2.5rem">
      <div class="product-quote-row">
        <div style="width:100%;max-width:680px">
          <LeadForm client:load />
        </div>
        {s.sideFeatures && (
          <div class="product-features reveal">
            <p class="eyebrow">Why {s.name.toLowerCase()}?</p>
            {s.sideFeatures.map((f) => (
              <div class="product-feature">
                <span class="tick-sm">✓</span>
                <div><b>{f.h}</b><p>{f.p}</p></div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  {s.slug === 'security-doors' && (
    <section class="block tint" id="screens">
      <div class="wrap">
        <div class="sec-head reveal">
          <p class="eyebrow">Choose your screen strength</p>
          <h2>Security door screen options</h2>
          <p>All our security doors are made to measure and available with a range of screen mesh options, from an entry-level everyday upgrade through to our heaviest-duty, Crimsafe-style screen. Screen thickness runs from 2mm up to 9mm depending on the tier.</p>
        </div>
        <div class="grid-3">
          {securityScreenOptions.map((o) => (
            <div class="pcard reveal">
              <span class="ph-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg></span>
              <div class:list={['ph', 'g1']} aria-label={`${o.name} security screen by Bay City Blinds, Geelong`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
              </div>
              <div class="body">
                <p class="eyebrow" style="margin-bottom:.2rem">{o.tier}{o.mm && ` · ${o.mm} screen`}</p>
                <h3>{o.name}</h3>
                <p>{o.blurb}</p>
                <ul style="margin:.7rem 0 0;padding:0;list-style:none;display:flex;flex-direction:column;gap:.35rem">
                  {o.features.map((f) => (
                    <li style="display:flex;gap:.45rem;align-items:flex-start;font-size:.9rem">
                      <span class="tick-sm" style="flex:none;margin-top:.1rem">✓</span>{f}
                    </li>
                  ))}
                </ul>
                <a class="lk" href="#quote" style="margin-top:.8rem;display:inline-flex">Get a price →</a>
              </div>
            </div>
          ))}
        </div>
        <p class="small" style="text-align:center;margin-top:1.2rem;opacity:.75">Not sure which screen suits your home? Jackson will talk you through the options on your free in-home measure &amp; quote.</p>
      </div>
    </section>
  )}

  <WhyUs />
  <Reviews />
  <ServiceAreas />
  <FinalCta />
</Layout>
