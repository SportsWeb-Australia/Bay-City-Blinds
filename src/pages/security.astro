---
import Layout from '../layouts/Layout.astro';
import WhyUs from '../components/WhyUs.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import FinalCta from '../components/FinalCta.astro';
import BenefitsGrid from '../components/BenefitsGrid.astro';
import VideoPlaceholder from '../components/VideoPlaceholder.astro';
import { securityStyles } from '../data/content';
import { localBusiness, serviceSchema, breadcrumb } from '../data/schema';

const title = 'Security Doors & Shutters Geelong | Bay City Blinds';
const description = 'Made-to-measure security doors and security shutters for Geelong homes. Free in-home measure & quote across Geelong & the Bellarine.';
const schemas = [
  localBusiness(),
  serviceSchema(),
  breadcrumb([{ name: 'Home', url: '/' }, { name: 'Security', url: '/security' }]),
];

const benefits = [
  { h: 'Real break-in deterrence', p: 'Sturdy, made-to-measure construction at the points burglars actually target, your doors and ground-floor windows.', ic: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>' },
  { h: 'Everyday, not just a lock-up', p: 'Ventilate and let light in with the door or shutter secured, not just an all-or-nothing barrier you only close when you leave.', ic: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>' },
  { h: 'Noise and insulation bonus', p: 'Security shutters double as sound and heat insulation, a genuine two-for-one on top of the security itself.', ic: '<path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/>' },
  { h: 'Styles that suit your home', p: 'Grille, mesh and shutter finishes chosen to match your home, not bolted on as an obvious afterthought.', ic: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>' },
];
---
<Layout title={title} description={description} path="/security" schemas={schemas}>
  <section class="block" style="padding-bottom:1rem">
    <div class="wrap">
      <div class="sec-head reveal" style="margin-bottom:1rem">
        <p class="eyebrow">Security window furnishings</p>
        <h1 style="font-family:'Bricolage Grotesque';font-weight:800;font-size:clamp(1.8rem,3.4vw,2.6rem);margin:.5rem 0 .6rem">Security doors &amp; shutters for Geelong homes</h1>
        <p>Made-to-measure security, fitted the same way as the rest of Jackson’s range: measured properly, installed tidily, and backed by a clear written quote.</p>
      </div>
    </div>
  </section>

  <BenefitsGrid items={benefits} />
  <VideoPlaceholder label="Security doors & shutters walkthrough video coming soon" />

  <section class="block tint" id="styles">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">What we fit</p>
        <h2>Security doors &amp; security shutters</h2>
        <p>Tap through for a free in-home measure &amp; quote on either.</p>
      </div>
      <div class="grid-3" style="max-width:760px;margin:0 auto">
        {securityStyles.map((s) => (
          <a class="pcard reveal" href={`/security/${s.slug}`}>
            <span class="ph-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg></span>
            <div class:list={['ph', s.gradient]} aria-label={`${s.name} by Bay City Blinds, Geelong`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            </div>
            <div class="body"><h3>{s.name}</h3><p>{s.blurb}</p><span class="lk">Get a price →</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <WhyUs />
  <ServiceAreas />
  <FinalCta />
</Layout>
