# Public (client-exposed) env vars — safe to be visible in the browser bundle.
# Set the real values in Vercel/Cloudflare Pages project settings, not in this repo.

# GA4 Measurement ID (src/components/BaseHead.astro). Site works fine without it.
PUBLIC_GA_ID=

# Google Maps JavaScript API key (src/components/ServiceAreaMap.tsx). Restrict this
# key to the site's production + preview domains in Google Cloud Console. Without
# it, the service-area section shows a styled fallback instead of the live map.
PUBLIC_GOOGLE_MAPS_API_KEY=
