# Public (client-exposed) env vars — safe to be visible in the browser bundle.
# Set the real values in Vercel/Cloudflare Pages project settings, not in this repo.

# GA4 Measurement ID (src/components/BaseHead.astro). Site works fine without it.
PUBLIC_GA_ID=

# Google Maps JavaScript API key (src/components/ServiceAreaMap.tsx). Restrict this
# key to the site's production + preview domains in Google Cloud Console. Without
# it, the service-area section shows a styled fallback instead of the live map.
PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Server-only secrets — set in Vercel/Cloudflare project settings, NEVER prefixed
# with PUBLIC_ and never committed. Used by src/lib/leadHandler.js (the /api/lead
# endpoint both api/lead.js [Vercel] and functions/api/lead.js [Cloudflare] call).

# ZeptoMail (Zoho transactional email) API token — Zoho Transactional Email console
# → Mail Agents → your agent → API tokens.
ZEPTOMAIL_TOKEN=

# The verified sending address/domain for that ZeptoMail agent.
ZEPTOMAIL_FROM_ADDRESS=

# Where lead notification emails go. Defaults to Jackson's real inbox.
JACKSON_NOTIFY_EMAIL=jackson@baycityblinds.com.au

# Set to "true" to short-circuit ZeptoMail with a canned success for local testing
# before real secrets exist. NEVER set this in production.
MOCK_PROVIDERS=
